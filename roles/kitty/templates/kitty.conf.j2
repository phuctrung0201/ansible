# Ansible — Catppuccin Mocha (from share.yml).

# Font
font_family FiraCode Nerd Font Mono
font_size 16

# Colors — official Catppuccin Mocha mapping (background dropped to Crust)
background {{ theme.crust }}
foreground {{ theme.text }}
selection_background {{ theme.surface2 }}
selection_foreground {{ theme.text }}
cursor {{ theme.rosewater }}
cursor_text_color {{ theme.base }}

# ANSI palette (0-7): black=Surface1, white=Subtext1
color0 {{ theme.surface1 }}
color1 {{ theme.red }}
color2 {{ theme.green }}
color3 {{ theme.yellow }}
color4 {{ theme.blue }}
color5 {{ theme.pink }}
color6 {{ theme.teal }}
color7 {{ theme.subtext1 }}
# Bright (8-15): bright black=Surface2, bright white=Subtext0, accents unchanged
color8 {{ theme.surface2 }}
color9 {{ theme.red }}
color10 {{ theme.green }}
color11 {{ theme.yellow }}
color12 {{ theme.blue }}
color13 {{ theme.pink }}
color14 {{ theme.teal }}
color15 {{ theme.subtext0 }}

# Cursor
cursor_shape beam

# macOS: Option sends Alt (tmux command palette Alt+Space, Neovim <a-h> / <a-i>)
macos_option_as_alt yes

# tmux integration — disable copy-on-select so it doesn't fight tmux copy mode
copy_on_select no

# Shell integration — auto-detect (fish is the default login shell)
shell_integration enabled

# View scrollback in Neovim (official kitty recipe, nvim 0.12+); q to quit.
scrollback_pager nvim --cmd 'set eventignore=FileType' +'nnoremap q ZQ' +'call nvim_open_term(0, {})' +'set nomodified nolist' +'$' -
# Open the scrollback buffer in nvim
map opt+shift+enter show_scrollback

# Close/quit without confirmation
confirm_os_window_close 0

# Window — hide titlebar but keep macOS rounded corners.
# titlebar-only preserves the rounded corners (yes/titlebar-and-corners square
# them off); the companion margin + placement settings stop the rounded corners
# from clipping cell text.
hide_window_decorations titlebar-only
# Tint the residual macOS titlebar strip to match the window background,
# otherwise it renders as a white/light bar under light appearance.
macos_titlebar_color background
placement_strategy top-left
window_margin_width 4
window_padding_width 4
