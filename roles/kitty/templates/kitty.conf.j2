# Ansible — Catppuccin Mocha (from share.yml).

# Font
font_family FiraCode Nerd Font Mono
font_size 16.0

# Colors — official Catppuccin Mocha mapping (background dropped to Crust)
foreground {{ theme.text }}
background {{ theme.crust }}
selection_foreground {{ theme.text }}
selection_background {{ theme.surface2 }}
cursor {{ theme.rosewater }}
cursor_text_color {{ theme.base }}

# ANSI palette
color0 {{ theme.surface1 }}
color1 {{ theme.red }}
color2 {{ theme.green }}
color3 {{ theme.yellow }}
color4 {{ theme.blue }}
color5 {{ theme.pink }}
color6 {{ theme.teal }}
color7 {{ theme.subtext1 }}
color8 {{ theme.surface2 }}
color9 {{ theme.red }}
color10 {{ theme.green }}
color11 {{ theme.yellow }}
color12 {{ theme.blue }}
color13 {{ theme.pink }}
color14 {{ theme.teal }}
color15 {{ theme.subtext0 }}

# Window and cursor
cursor_shape beam
# Keep titlebar-only chrome on macOS.
hide_window_decorations titlebar-only
macos_titlebar_color background
window_padding_width 4

# macOS behavior
macos_option_as_alt yes
confirm_os_window_close 0

# Scrollback in Neovim buffer
scrollback_pager nvim --cmd 'set eventignore=FileType' +'nnoremap q ZQ' +'call nvim_open_term(0, {})' +'set nomodified nolist' +'$' -
map opt+shift+enter show_scrollback

# Keep shell integration automatic (fish is the default login shell)
shell_integration enabled
