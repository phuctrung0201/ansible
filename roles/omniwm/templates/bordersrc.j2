#!/bin/bash
# JankyBorders config — managed by ansible (roles/omniwm/templates/bordersrc.j2).
# OmniWM has its own [borders] section, but it is deliberately disabled in
# files/config.toml in favour of this. Colours come from share.yml so the focus
# border matches the One Dark palette used across nvim/tmux/ghostty/fish.
#
# OmniWM's built-in borders were tried and dropped: it fills the corner ring
# between two independently antialiased arcs, which leaves partial-coverage pixels
# that read as a broken corner at thin widths. It also borders only the focused
# window, so there is no inactive colour.
#
# Note: bordersrc has no hot reload. After changing it, run
#   brew services restart borders
options=(
	style=round
	width=4.0
	hidpi=off
	active_color=0xff{{ theme.purple | replace("#", "") | lower }}
	inactive_color=0x30{{ theme.comment_bright | replace("#", "") | lower }}
)

borders "${options[@]}"
