{# Window borders — colors from share.yml (same pairing as Ghostty active/inactive borders). #}
{% set _border_active = theme.purple | replace("#", "") | upper %}
{% set _border_inactive = theme.comment_bright | replace("#", "") | upper %}
after-login-command = []

after-startup-command = [
'exec-and-forget borders active_color=0xCC{{ _border_active }} inactive_color=0x30{{ _border_inactive }} width=3.0'
]

# Start AeroSpace at login
start-at-login = true

# Normalizations. See: https://nikitabobko.github.io/AeroSpace/guide#normalization
enable-normalization-flatten-containers = true
enable-normalization-opposite-orientation-for-nested-containers = true

# You can set 0 to disable the padding feature
accordion-padding = 30

# Possible values: tiles|accordion
default-root-container-layout = 'tiles'

# Run when the focused workspace changes. Doc pattern: https://nikitabobko.github.io/AeroSpace/guide#exec-on-workspace-change-callback
# Same shape as the SketchyBar example: /bin/bash -c "<script>" (argv0 is not resolved via PATH; the shell finds im-select).
# Env: AEROSPACE_FOCUSED_WORKSPACE, AEROSPACE_PREV_WORKSPACE. English layout id: run `im-select` with no args to print current.
# No [exec] block: AeroSpace defaults already prepend /opt/homebrew to PATH for exec-* (guide §2.7). Add [exec.env-vars] only for Intel Homebrew (/usr/local), ~/bin, etc.
exec-on-workspace-change = ['/bin/bash', '-c', 'im-select com.apple.keylayout.ABC']

[key-mapping]
preset = 'qwerty'

[gaps]
inner.horizontal = 8
inner.vertical = 8
outer.left = 4
outer.bottom = 4
outer.top = 4
outer.right = 4

# Window management: AeroSpace's `ctrl-` prefix is the Control key.
# No separate binding mode — chords run directly from main mode.
# Workspaces: 1=terminal+obsidian 2=browser 3=fallback F1=screen 1 F2=screen 2
[mode.main.binding]

# tab/backslash in the old action mode → Control+key
ctrl-backslash = 'focus-monitor --wrap-around next'
ctrl-shift-backslash = 'move-workspace-to-monitor --wrap-around next'
ctrl-tab = 'workspace next --wrap-around'
ctrl-shift-tab = 'workspace prev --wrap-around'
ctrl-backtick = 'workspace-back-and-forth'

# Window focus (brackets)
ctrl-leftSquareBracket = 'focus dfs-prev --boundaries workspace --boundaries-action wrap-around-the-workspace'
ctrl-rightSquareBracket = 'focus dfs-next --boundaries workspace --boundaries-action wrap-around-the-workspace'

# Focus (Control+arrows — avoids clashing with hjkl in nvim/terminals)
ctrl-left = 'focus left'
ctrl-down = 'focus down'
ctrl-up = 'focus up'
ctrl-right = 'focus right'

# Move windows (Control+Shift+arrows)
ctrl-shift-left = 'move left'
ctrl-shift-down = 'move down'
ctrl-shift-up = 'move up'
ctrl-shift-right = 'move right'

# Workspaces
ctrl-1 = 'workspace 1'
ctrl-2 = 'workspace 2'
ctrl-3 = 'workspace 3'
ctrl-4 = 'workspace 4'
ctrl-f1 = 'summon-workspace 1'
ctrl-f2 = 'summon-workspace 2'
ctrl-f3 = 'summon-workspace 3'
ctrl-f4 = 'summon-workspace 4'
ctrl-shift-1 = 'move-node-to-workspace --focus-follows-window 1'
ctrl-shift-2 = 'move-node-to-workspace --focus-follows-window 2'
ctrl-shift-3 = 'move-node-to-workspace --focus-follows-window 3'
ctrl-shift-4 = 'move-node-to-workspace --focus-follows-window 4'


# Layout
ctrl-t = 'layout accordion tiles'
ctrl-f = 'layout floating tiling'

# Resize
ctrl-minus = 'resize smart -100'
ctrl-equal = 'resize smart +100'
ctrl-0 = 'balance-sizes'

# Service
ctrl-r = 'reload-config'
ctrl-w = 'close'
ctrl-shift-w = 'close-all-windows-but-current'

# List current opening apps
# aerospace list-apps
[[on-window-detected]]
if.app-id = 'com.mitchellh.ghostty'
run = 'move-node-to-workspace --focus-follows-window 1'

[[on-window-detected]]
if.app-id = 'app.zen-browser.zen'
run = 'move-node-to-workspace --focus-follows-window 2'

[[on-window-detected]]
if.app-id = 'company.thebrowser.Browser'
run = 'move-node-to-workspace --focus-follows-window 2'

[[on-window-detected]]
if.app-id = 'org.mozilla.firefox'
run = 'move-node-to-workspace --focus-follows-window 2'

[[on-window-detected]]
if.app-id = 'md.obsidian'
run = 'move-node-to-workspace --focus-follows-window 1'

[[on-window-detected]]
check-further-callbacks = true
run = 'move-node-to-workspace --focus-follows-window 3'
