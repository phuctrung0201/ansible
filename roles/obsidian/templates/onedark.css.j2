{# One Dark for Obsidian's default dark theme (share.yml → Obsidian CSS variables). #}
{# Palette source: onedarkpro "onedark_dark" — see roles/nvim's colorscheme.lua. #}
{% macro rgb(hex) -%}
{{ hex[1:3] | int(0, 16) }}, {{ hex[3:5] | int(0, 16) }}, {{ hex[5:7] | int(0, 16) }}
{%- endmacro %}
body.theme-dark {
  /* ── Mono + accent HSL ─────────────────────────────────────────────── */
  --mono-rgb-0: 0, 0, 0;
  --mono-rgb-100: 255, 255, 255;
  --accent-h: 207;
  --accent-s: 82%;
  --accent-l: 66%;

  /* ── Extended palette (share.yml) ────────────────────────────────────── */
  --color-red-rgb: {{ rgb(theme.red) }};
  --color-red: {{ theme.red }};
  --color-orange-rgb: {{ rgb(theme.orange) }};
  --color-orange: {{ theme.orange }};
  --color-yellow-rgb: {{ rgb(theme.yellow) }};
  --color-yellow: {{ theme.yellow }};
  --color-green-rgb: {{ rgb(theme.green) }};
  --color-green: {{ theme.green }};
  --color-cyan-rgb: {{ rgb(theme.cyan) }};
  --color-cyan: {{ theme.cyan }};
  --color-blue-rgb: {{ rgb(theme.blue) }};
  --color-blue: {{ theme.blue }};
  --color-purple-rgb: {{ rgb(theme.purple) }};
  --color-purple: {{ theme.purple }};
  --color-pink-rgb: {{ rgb(theme.pink) }};
  --color-pink: {{ theme.pink }};

  /* ── Base scale: bg → fg (share.yml) ─────────────────────────────────── */
  --color-base-00: {{ theme.bg }};
  --color-base-05: {{ theme.surface0 }};
  --color-base-10: {{ theme.surface0 }};
  --color-base-20: {{ theme.selection }};
  --color-base-25: {{ theme.nontext }};
  --color-base-30: {{ theme.dark }};
  --color-base-35: {{ theme.dark }};
  --color-base-40: {{ theme.dark }};
  --color-base-50: {{ theme.comment }};
  --color-base-60: {{ theme.comment }};
  --color-base-70: {{ theme.comment }};
  --color-base-100: {{ theme.fg }};

  --color-accent-hsl: var(--accent-h), var(--accent-s), var(--accent-l);
  --color-accent: hsl(var(--accent-h), var(--accent-s), var(--accent-l));
  --color-accent-1: hsl(var(--accent-h), var(--accent-s), calc(var(--accent-l) + 3.8%));
  --color-accent-2: hsl(var(--accent-h), var(--accent-s), calc(var(--accent-l) + 8%));

  /* ── Surfaces ──────────────────────────────────────────────────────── */
  --background-primary: var(--color-base-00);
  --background-primary-alt: var(--color-base-10);
  --background-secondary: var(--color-base-10);
  --background-secondary-alt: var(--color-base-20);
  --background-modifier-hover: rgba(var(--mono-rgb-100), 0.067);
  --background-modifier-active-hover: hsla(var(--interactive-accent-hsl), 0.1);
  --background-modifier-border: var(--color-base-30);
  --background-modifier-border-hover: var(--color-base-35);
  --background-modifier-border-focus: var(--color-base-40);
  --background-modifier-error-rgb: var(--color-red-rgb);
  --background-modifier-error: var(--color-red);
  --background-modifier-error-hover: var(--color-red);
  --background-modifier-success-rgb: var(--color-green-rgb);
  --background-modifier-success: var(--color-green);
  --background-modifier-message: rgba(0, 0, 0, 0.9);
  --background-modifier-form-field: var(--color-base-10);
  --background-modifier-form-field-hover: var(--color-base-20);

  /* ── Text ──────────────────────────────────────────────────────────── */
  --text-normal: var(--color-base-100);
  --text-muted: var(--color-base-70);
  --text-faint: var(--color-base-50);
  --text-on-accent: {{ theme.bg }};
  --text-on-accent-inverted: {{ theme.fg }};
  --text-error: var(--color-red);
  --text-warning: var(--color-orange);
  --text-success: var(--color-green);
  --text-accent: {{ theme.blue }};
  --text-accent-hover: {{ theme.bright_cyan }};
  --text-selection: hsla(var(--interactive-accent-hsl), 0.25);
  --text-highlight-bg-rgb: {{ rgb(theme.yellow) }};
  --text-highlight-bg: rgba(var(--text-highlight-bg-rgb), 0.35);

  /* ── Interactive ───────────────────────────────────────────────────── */
  --interactive-normal: var(--color-base-30);
  --interactive-hover: var(--color-base-35);
  --interactive-accent-hsl: var(--color-accent-hsl);
  --interactive-accent: {{ theme.blue }};
  --interactive-accent-hover: {{ theme.bright_cyan }};

  /* ── Links ───────────────────────────────────────────────────────────── */
  --link-color: {{ theme.blue }};
  --link-color-hover: {{ theme.bright_cyan }};
  --link-external-color: {{ theme.blue }};
  --link-external-color-hover: {{ theme.bright_cyan }};
  --link-unresolved-color: {{ theme.purple }};
  --link-unresolved-decoration-color: hsla(var(--interactive-accent-hsl), 0.3);

  /* ── Headings + inline title ───────────────────────────────────────── */
  --heading-formatting: var(--text-faint);
  --h1-color: {{ theme.red }};
  --h2-color: {{ theme.orange }};
  --h3-color: {{ theme.yellow }};
  --h4-color: {{ theme.green }};
  --h5-color: {{ theme.cyan }};
  --h6-color: {{ theme.purple }};
  --inline-title-color: var(--text-normal);
  --bold-color: {{ theme.white }};
  --italic-color: var(--text-normal);

  /* ── Code + syntax ───────────────────────────────────────────────────── */
  --code-background: var(--background-primary-alt);
  --code-normal: var(--text-normal);
  --code-comment: var(--text-faint);
  --code-function: var(--color-yellow);
  --code-important: var(--color-orange);
  --code-keyword: var(--color-purple);
  --code-operator: var(--color-red);
  --code-property: var(--color-cyan);
  --code-punctuation: var(--text-muted);
  --code-string: var(--color-green);
  --code-tag: var(--color-red);
  --code-value: var(--color-purple);

  /* ── Lists, blockquotes, hr ──────────────────────────────────────────── */
  --list-marker-color: var(--text-muted);
  --list-marker-color-hover: var(--text-normal);
  --list-marker-color-collapsed: var(--text-accent);
  --blockquote-border-color: var(--text-accent);
  --blockquote-color: var(--text-muted);
  --hr-color: var(--background-modifier-border);

  /* ── Checkboxes + carets ─────────────────────────────────────────────── */
  --checkbox-color: var(--text-accent);
  --checkbox-color-hover: var(--text-accent-hover);
  --checkbox-border-color: var(--text-faint);
  --checkbox-border-color-hover: var(--text-muted);
  --checkbox-marker-color: var(--background-primary);
  --checklist-done-color: var(--text-muted);
  --caret-color: var(--text-normal);

  /* ── Tags ────────────────────────────────────────────────────────────── */
  --tag-color: {{ theme.purple }};
  --tag-color-hover: {{ theme.pink }};
  --tag-background: hsla(var(--interactive-accent-hsl), 0.1);
  --tag-background-hover: hsla(var(--interactive-accent-hsl), 0.2);
  --tag-border-color: hsla(var(--interactive-accent-hsl), 0.15);
  --tag-border-color-hover: hsla(var(--interactive-accent-hsl), 0.25);

  /* ── Callouts (RGB triplets) ─────────────────────────────────────────── */
  --callout-quote: {{ rgb(theme.comment) }};

  /* ── Canvas + graph ──────────────────────────────────────────────────── */
  --canvas-background: var(--background-primary);
  --canvas-dot-pattern: var(--color-base-30);
  --canvas-card-label-color: var(--text-faint);
  --graph-text: var(--text-normal);
  --graph-node: var(--text-muted);
  --graph-node-unresolved: var(--text-faint);
  --graph-node-focused: var(--text-accent);
  --graph-node-tag: var(--color-green);
  --graph-node-attachment: var(--color-yellow);
  --graph-line: var(--color-base-35);

  /* ── Navigation + tabs + chrome ──────────────────────────────────────── */
  --nav-item-color: var(--text-muted);
  --nav-item-color-hover: var(--text-normal);
  --nav-item-color-active: var(--text-normal);
  --nav-item-color-selected: var(--text-normal);
  --nav-item-color-highlighted: var(--text-accent);
  --nav-item-background-active: var(--background-modifier-hover);
  --nav-item-background-hover: var(--background-modifier-hover);
  --nav-item-background-selected: hsla(var(--color-accent-hsl), 0.15);
  --nav-heading-color: var(--text-muted);
  --nav-heading-color-hover: var(--text-normal);
  --nav-collapse-icon-color: var(--text-faint);
  --nav-collapse-icon-color-collapsed: var(--text-accent);
  --nav-tag-color: var(--text-faint);
  --nav-tag-color-hover: var(--text-muted);
  --nav-tag-color-active: var(--text-muted);

  --tab-text-color: var(--text-faint);
  --tab-text-color-active: var(--text-muted);
  --tab-text-color-focused: var(--text-muted);
  --tab-text-color-focused-active: var(--text-muted);
  --tab-text-color-focused-active-current: var(--text-normal);
  --tab-text-color-focused-highlighted: var(--text-accent);
  --tab-background-active: var(--background-primary);
  --tab-container-background: var(--background-secondary);
  --tab-divider-color: var(--background-modifier-border);
  --tab-outline-color: var(--background-modifier-border);

  --titlebar-background: var(--background-secondary);
  --titlebar-background-focused: var(--background-secondary-alt);
  --titlebar-text-color: var(--text-muted);
  --titlebar-text-color-focused: var(--text-normal);
  --titlebar-border-color: var(--background-modifier-border);

  --ribbon-background: var(--background-secondary);
  --ribbon-background-collapsed: var(--background-primary);
  --status-bar-background: var(--background-secondary);
  --status-bar-text-color: var(--text-muted);
  --status-bar-border-color: var(--background-modifier-border);

  /* ── Icons + scrollbars ──────────────────────────────────────────────── */
  --icon-color: var(--text-muted);
  --icon-color-hover: var(--text-normal);
  --icon-color-active: var(--text-accent);
  --icon-color-focused: var(--text-normal);
  --scrollbar-bg: rgba(var(--mono-rgb-100), 0.05);
  --scrollbar-thumb-bg: rgba(var(--mono-rgb-100), 0.1);
  --scrollbar-active-thumb-bg: rgba(var(--mono-rgb-100), 0.2);

  /* ── Dividers + collapse ─────────────────────────────────────────────── */
  --divider-color: var(--background-modifier-border);
  --divider-color-hover: var(--text-accent);
  --collapse-icon-color: var(--text-faint);
  --collapse-icon-color-collapsed: var(--text-accent);
  --indentation-guide-color: rgba(var(--mono-rgb-100), 0.12);
  --indentation-guide-color-active: rgba(var(--mono-rgb-100), 0.3);

  /* ── Modals, prompts, menus, search ──────────────────────────────────── */
  --modal-background: var(--background-primary);
  --modal-border-color: var(--background-modifier-border);
  --modal-sidebar-background: var(--background-secondary);
  --prompt-background: var(--background-primary);
  --prompt-border-color: var(--color-base-40);
  --menu-background: var(--background-secondary);
  --menu-border-color: var(--background-modifier-border-hover);
  --suggestion-background: var(--background-primary);
  --search-result-background: var(--background-primary);
  --search-icon-color: var(--text-muted);
  --search-clear-button-color: var(--text-muted);
  --input-placeholder-color: var(--text-faint);

  /* ── Metadata + properties ───────────────────────────────────────────── */
  --metadata-border-color: var(--background-modifier-border);
  --metadata-divider-color: var(--background-modifier-border);
  --metadata-label-text-color: var(--text-muted);
  --metadata-label-text-color-hover: var(--text-muted);
  --metadata-input-text-color: var(--text-normal);
  --metadata-property-background-active: var(--background-modifier-hover);

  /* ── Tables ──────────────────────────────────────────────────────────── */
  --table-border-color: var(--background-modifier-border);
  --table-header-color: var(--text-normal);
  --table-selection: hsla(var(--color-accent-hsl), 0.1);
  --table-selection-border-color: var(--interactive-accent);
  --table-drag-handle-color: var(--text-faint);
  --table-drag-handle-color-active: var(--text-on-accent);

  /* ── PDF + embeds ────────────────────────────────────────────────────── */
  --pdf-background: var(--background-primary);
  --pdf-page-background: var(--background-primary);
  --pdf-sidebar-background: var(--background-primary);
  --embed-border-start: 2px solid var(--interactive-accent);

  /* ── Settings + vault ──────────────────────────────────────────────────── */
  --setting-group-heading-color: var(--text-normal);
  --setting-items-background: var(--background-primary-alt);
  --setting-items-border-color: var(--background-modifier-border);
  --vault-profile-color: var(--text-normal);
  --vault-profile-color-hover: var(--text-normal);

  /* ── Sync avatars (palette order) ────────────────────────────────────── */
  --sync-avatar-color-1: var(--color-red);
  --sync-avatar-color-2: var(--color-orange);
  --sync-avatar-color-3: var(--color-yellow);
  --sync-avatar-color-4: var(--color-green);
  --sync-avatar-color-5: var(--color-cyan);
  --sync-avatar-color-6: var(--color-blue);
  --sync-avatar-color-7: var(--color-purple);
  --sync-avatar-color-8: var(--color-pink);

  /* ── Slider + toggle track ───────────────────────────────────────────── */
  --slider-track-background: var(--background-modifier-border);
  --slider-thumb-border-color: var(--background-modifier-border-hover);
}
