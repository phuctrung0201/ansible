# Catppuccin Mocha colors — managed by Ansible (values from share.yml).
# Syntax-highlight roles follow the official catppuccin/fish "Mocha" theme.

set -g fish_color_normal "{{ theme.text }}"
set -g fish_color_command "{{ theme.blue }}"
set -g fish_color_keyword "{{ theme.pink }}"
set -g fish_color_quote "{{ theme.green }}"
set -g fish_color_redirection "{{ theme.pink }}"
set -g fish_color_end "{{ theme.peach }}"
set -g fish_color_error "{{ theme.red }}"
set -g fish_color_param "{{ theme.flamingo }}"
set -g fish_color_comment "{{ theme.overlay0 }}"
set -g fish_color_gray "{{ theme.overlay0 }}"
set -g fish_color_selection --background="{{ theme.surface1 }}"
set -g fish_color_search_match --background="{{ theme.surface1 }}"
set -g fish_color_option "{{ theme.green }}"
set -g fish_color_operator "{{ theme.pink }}"
set -g fish_color_escape "{{ theme.maroon }}"
set -g fish_color_autosuggestion "{{ theme.overlay0 }}"
set -g fish_color_cancel "{{ theme.red }}"
set -g fish_color_valid_path
set -g fish_pager_color_progress "{{ theme.overlay0 }}"
set -g fish_pager_color_prefix "{{ theme.pink }}" --bold
set -g fish_pager_color_completion "{{ theme.text }}"
set -g fish_pager_color_description "{{ theme.overlay0 }}"
set -g fish_pager_color_selected_background --background="{{ theme.surface1 }}"

# Prompt colors (referenced by 20-prompt.fish)
set -g fish_color_cwd "{{ theme.blue }}"
set -g fish_color_vcs "{{ theme.mauve }}"
set -g fish_color_zmx "{{ theme.teal }}"

# vi-mode indicator colors (referenced by 20-prompt.fish)
# normal=blue, insert=green, replace=peach, visual=mauve.
set -g fish_mode_color_insert  "{{ theme.green }}"
set -g fish_mode_color_default "{{ theme.blue }}"
set -g fish_mode_color_replace "{{ theme.peach }}"
set -g fish_mode_color_visual  "{{ theme.mauve }}"
# Foreground for the mini.nvim-style mode block (dark text on colored bg).
set -g fish_mode_fg "{{ theme.crust }}"
