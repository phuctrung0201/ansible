# Rift settings — managed by Ansible (roles/rift/templates/config.toml.j2).

[settings]
default_disable = false
animate = true
animation_duration = 0.3
focus_follows_mouse = false
mouse_follows_focus = false
mouse_hides_on_focus = false
hot_reload = true
run_on_start = []

[settings.layout]
mode = "scrolling"

[settings.layout.scrolling]
animate = true
column_width_ratio = 0.5
preset_column_widths = [0.25, 0.5, 0.75, 1.0]
preserve_window_sizes = true
min_column_width_ratio = 0.25
max_column_width_ratio = 1.0
alignment = "center"
focus_navigation_style = "niri"

[settings.layout.scrolling.gestures]
enabled = false

[settings.layout.gaps.outer]
top = 8
left = 8
bottom = 8
right = 8

[settings.layout.gaps.inner]
horizontal = 8
vertical = 8

[settings.ui.mission_control]
enabled = true
show_empty_workspaces = false

[settings.ui.menu_bar]
enabled = false

[settings.gestures]
enabled = false

[virtual_workspaces]
enabled = false

[keys]
"Alt + H" = { move_focus = "left" }
"Alt + L" = { move_focus = "right" }
"Alt + K" = { move_focus = "up" }
"Alt + J" = { move_focus = "down" }

"Alt + Shift + H" = { move_node = "left" }
"Alt + Shift + L" = { move_node = "right" }
"Alt + Shift + K" = { move_node = "up" }
"Alt + Shift + J" = { move_node = "down" }

"Alt + Tab" = "next_window"
"Alt + Shift + Tab" = "prev_window"

"Alt + Semicolon" = { consume_or_expel_window = "right" }
"Alt + Shift + Semicolon" = { consume_or_expel_window = "left" }

"Alt + BracketLeft" = { switch_preset_column_width = { backwards = true } }
"Alt + BracketRight" = "switch_preset_column_width"
"Alt + Shift + BracketLeft" = { resize_window_shrink = "vertical" }
"Alt + Shift + BracketRight" = { resize_window_grow = "vertical" }


"Alt + Quote" = "show_mission_control_current"
"Alt + Shift + Quote" = "show_mission_control_all"

"Alt + Backslash" = "toggle_fullscreen_within_gaps"
"Alt + Shift + Backslash" = "toggle_window_floating"

"Alt + R" = "reload_config"
"Alt + Q" = "save_and_exit"

# Kitty quick access terminal
"Alt + Space" = { exec = ["/bin/sh", "-c", "cd \"$HOME\" && /opt/homebrew/bin/kitten quick-access-terminal >/dev/null 2>&1 &"] }
