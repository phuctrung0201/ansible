# Ansible — Catppuccin Mocha (from share.yml).

# Font
font-family = FiraCode Nerd Font Mono
font-size = 16

# Colors — official Catppuccin Mocha mapping (background dropped to Crust)
background = {{ theme.crust }}
foreground = {{ theme.text }}
selection-background = {{ theme.surface2 }}
selection-foreground = {{ theme.text }}
cursor-color = {{ theme.rosewater }}
cursor-text = {{ theme.base }}

# ANSI palette (0-7): black=Surface1, white=Subtext1
palette = 0={{ theme.surface1 }}
palette = 1={{ theme.red }}
palette = 2={{ theme.green }}
palette = 3={{ theme.yellow }}
palette = 4={{ theme.blue }}
palette = 5={{ theme.pink }}
palette = 6={{ theme.teal }}
palette = 7={{ theme.subtext1 }}
# Bright (8-15): bright black=Surface2, bright white=Subtext0, accents unchanged
palette = 8={{ theme.surface2 }}
palette = 9={{ theme.red }}
palette = 10={{ theme.green }}
palette = 11={{ theme.yellow }}
palette = 12={{ theme.blue }}
palette = 13={{ theme.pink }}
palette = 14={{ theme.teal }}
palette = 15={{ theme.subtext0 }}

# Cursor
cursor-style = bar

# macOS: Option sends Alt (tmux command palette Alt+Space, Neovim <a-h> / <a-i>)
macos-option-as-alt = true

# tmux integration — Ghostty copy-on-select fights tmux copy mode
copy-on-select = false

# Shell integration — auto-detect (fish is the default login shell)
shell-integration = detect
shell-integration-features = cursor,sudo,title,path

# Close/quit without confirmation (Cmd+Q, window close, tab close)
confirm-close-surface = false

# Window — hidden titlebar
macos-titlebar-style = hidden
window-padding-x = 4
window-padding-y = 4
window-padding-balance = true

# Tab bar styling — keep native, just hide the new-tab button area visually
window-theme = ghostty

# Dump the visible screen to a temp file and copy that file's path to the
# clipboard. write_screen_file captures the visible screen (always has content);
# the scrollback variant is empty on a fresh terminal.
keybind = opt+shift+enter=write_screen_file:copy
